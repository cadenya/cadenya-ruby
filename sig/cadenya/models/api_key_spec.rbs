module Cadenya
  module Models
    type api_key_spec =
      {
        token: String,
        description: String,
        permissions: ::Array[String],
        system_: bool
      }

    class APIKeySpec < Cadenya::Internal::Type::BaseModel
      attr_reader description: String?

      def description=: (String) -> String

      attr_reader permissions: ::Array[String]?

      def permissions=: (::Array[String]) -> ::Array[String]

      attr_reader token: String?

      def token=: (String) -> String

      attr_reader system_: bool?

      def system_=: (bool) -> bool

      def initialize: (
        ?token: String,
        ?description: String,
        ?permissions: ::Array[String],
        ?system_: bool
      ) -> void

      def to_hash: -> {
        token: String,
        description: String,
        permissions: ::Array[String],
        system_: bool
      }
    end
  end
end
