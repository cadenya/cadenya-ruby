module Cadenya
  module Models
    type objective_compact_params =
      {
        workspace_id: String,
        objective_id: String,
        compaction_config: Cadenya::Agents::AgentVariationSpecCompactionConfig
      }
      & Cadenya::Internal::Type::request_parameters

    class ObjectiveCompactParams < Cadenya::Internal::Type::BaseModel
      extend Cadenya::Internal::Type::RequestParameters::Converter
      include Cadenya::Internal::Type::RequestParameters

      attr_accessor workspace_id: String

      attr_accessor objective_id: String

      attr_reader compaction_config: Cadenya::Agents::AgentVariationSpecCompactionConfig?

      def compaction_config=: (
        Cadenya::Agents::AgentVariationSpecCompactionConfig
      ) -> Cadenya::Agents::AgentVariationSpecCompactionConfig

      def initialize: (
        workspace_id: String,
        objective_id: String,
        ?compaction_config: Cadenya::Agents::AgentVariationSpecCompactionConfig,
        ?request_options: Cadenya::request_opts
      ) -> void

      def to_hash: -> {
        workspace_id: String,
        objective_id: String,
        compaction_config: Cadenya::Agents::AgentVariationSpecCompactionConfig,
        request_options: Cadenya::RequestOptions
      }
    end
  end
end
