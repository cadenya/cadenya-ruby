module Cadenya
  module Models
    type tool_entry =
      {
        name: String,
        spec: Cadenya::ToolSets::ToolSpec,
        labels: ::Hash[Symbol, String]
      }

    class ToolEntry < Cadenya::Internal::Type::BaseModel
      attr_accessor name: String

      attr_accessor spec: Cadenya::ToolSets::ToolSpec

      attr_reader labels: ::Hash[Symbol, String]?

      def labels=: (::Hash[Symbol, String]) -> ::Hash[Symbol, String]

      def initialize: (
        name: String,
        spec: Cadenya::ToolSets::ToolSpec,
        ?labels: ::Hash[Symbol, String]
      ) -> void

      def to_hash: -> {
        name: String,
        spec: Cadenya::ToolSets::ToolSpec,
        labels: ::Hash[Symbol, String]
      }
    end
  end
end
