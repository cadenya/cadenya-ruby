module Cadenya
  module Models
    type objective_continue_params =
      {
        workspace_id: String,
        objective_id: String,
        message: String,
        enqueue: bool
      }
      & Cadenya::Internal::Type::request_parameters

    class ObjectiveContinueParams < Cadenya::Internal::Type::BaseModel
      extend Cadenya::Internal::Type::RequestParameters::Converter
      include Cadenya::Internal::Type::RequestParameters

      attr_reader workspace_id: String?

      def workspace_id=: (String) -> String

      attr_accessor objective_id: String

      attr_accessor message: String

      attr_reader enqueue: bool?

      def enqueue=: (bool) -> bool

      def initialize: (
        objective_id: String,
        message: String,
        ?workspace_id: String,
        ?enqueue: bool,
        ?request_options: Cadenya::request_opts
      ) -> void

      def to_hash: -> {
        workspace_id: String,
        objective_id: String,
        message: String,
        enqueue: bool,
        request_options: Cadenya::RequestOptions
      }
    end
  end
end
