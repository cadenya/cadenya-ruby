module Cadenya
  module Models
    type tool_result =
      {
        result: Cadenya::Objectives::ObjectiveToolCallResult,
        tool_call_id: String
      }

    class ToolResult < Cadenya::Internal::Type::BaseModel
      attr_accessor result: Cadenya::Objectives::ObjectiveToolCallResult

      attr_accessor tool_call_id: String

      def initialize: (
        result: Cadenya::Objectives::ObjectiveToolCallResult,
        tool_call_id: String
      ) -> void

      def to_hash: -> {
        result: Cadenya::Objectives::ObjectiveToolCallResult,
        tool_call_id: String
      }
    end
  end
end
