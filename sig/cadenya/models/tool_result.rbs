module Cadenya
  module Models
    type tool_result = { content: String, tool_call_id: String }

    class ToolResult < Cadenya::Internal::Type::BaseModel
      attr_reader content: String?

      def content=: (String) -> String

      attr_reader tool_call_id: String?

      def tool_call_id=: (String) -> String

      def initialize: (?content: String, ?tool_call_id: String) -> void

      def to_hash: -> { content: String, tool_call_id: String }
    end
  end
end
