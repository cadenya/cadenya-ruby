module Cadenya
  module Models
    type tool_denied = { memo: String, tool_call_id: String }

    class ToolDenied < Cadenya::Internal::Type::BaseModel
      attr_reader memo: String?

      def memo=: (String) -> String

      attr_reader tool_call_id: String?

      def tool_call_id=: (String) -> String

      def initialize: (?memo: String, ?tool_call_id: String) -> void

      def to_hash: -> { memo: String, tool_call_id: String }
    end
  end
end
