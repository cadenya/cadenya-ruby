module Cadenya
  module Models
    module Workspaces
      type member_add_params =
        { workspace_id: String, profile_id: String }
        & Cadenya::Internal::Type::request_parameters

      class MemberAddParams < Cadenya::Internal::Type::BaseModel
        extend Cadenya::Internal::Type::RequestParameters::Converter
        include Cadenya::Internal::Type::RequestParameters

        attr_accessor workspace_id: String

        attr_reader profile_id: String?

        def profile_id=: (String) -> String

        def initialize: (
          workspace_id: String,
          ?profile_id: String,
          ?request_options: Cadenya::request_opts
        ) -> void

        def to_hash: -> {
          workspace_id: String,
          profile_id: String,
          request_options: Cadenya::RequestOptions
        }
      end
    end
  end
end
