module Cadenya
  module Models
    type resource_metadata =
      {
        id: String,
        account_id: String,
        created_at: Time,
        name: String,
        profile_id: String,
        workspace_id: String,
        bundle_key: String,
        external_id: String,
        labels: ::Hash[Symbol, String],
        updated_at: Time
      }

    class ResourceMetadata < Cadenya::Internal::Type::BaseModel
      attr_accessor name: String

      attr_reader bundle_key: String?

      def bundle_key=: (String) -> String

      attr_reader external_id: String?

      def external_id=: (String) -> String

      attr_reader labels: ::Hash[Symbol, String]?

      def labels=: (::Hash[Symbol, String]) -> ::Hash[Symbol, String]

      attr_accessor id: String

      attr_accessor account_id: String

      attr_accessor created_at: Time

      attr_accessor profile_id: String

      attr_accessor workspace_id: String

      attr_reader updated_at: Time?

      def updated_at=: (Time) -> Time

      def initialize: (
        id: String,
        account_id: String,
        created_at: Time,
        name: String,
        profile_id: String,
        workspace_id: String,
        ?bundle_key: String,
        ?external_id: String,
        ?labels: ::Hash[Symbol, String],
        ?updated_at: Time
      ) -> void

      def to_hash: -> {
        id: String,
        account_id: String,
        created_at: Time,
        name: String,
        profile_id: String,
        workspace_id: String,
        bundle_key: String,
        external_id: String,
        labels: ::Hash[Symbol, String],
        updated_at: Time
      }
    end
  end
end
