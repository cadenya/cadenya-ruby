module Cadenya
  module Models
    type resource_metadata =
      {
        id: String,
        account_id: String,
        created_at: Time,
        name: String,
        profile_id: String,
        workspace_id: String,
        external_id: String,
        labels: ::Hash[Symbol, String],
        updated_at: Time
      }

    class ResourceMetadata < Cadenya::Internal::Type::BaseModel
      attr_accessor name: String

      attr_accessor external_id: String

      attr_accessor labels: ::Hash[Symbol, String]

      attr_accessor id: String

      attr_accessor account_id: String

      attr_accessor created_at: Time

      attr_accessor profile_id: String

      attr_accessor workspace_id: String

      attr_reader updated_at: Time?

      def updated_at=: (Time) -> Time

      def initialize: (
        id: String,
        account_id: String,
        created_at: Time,
        name: String,
        profile_id: String,
        workspace_id: String,
        external_id: String,
        labels: ::Hash[Symbol, String],
        ?updated_at: Time
      ) -> void

      def to_hash: -> {
        id: String,
        account_id: String,
        created_at: Time,
        name: String,
        profile_id: String,
        workspace_id: String,
        external_id: String,
        labels: ::Hash[Symbol, String],
        updated_at: Time
      }
    end
  end
end
