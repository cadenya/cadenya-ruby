module Cadenya
  module Models
    type assistant_tool_call =
      {
        arguments: String,
        function_name: String,
        tool: Cadenya::Models::callable_tool
      }

    class AssistantToolCall < Cadenya::Internal::Type::BaseModel
      attr_accessor arguments: String

      attr_accessor function_name: String

      attr_reader tool: Cadenya::Models::callable_tool?

      def tool=: (
        Cadenya::Models::callable_tool
      ) -> Cadenya::Models::callable_tool

      def initialize: (
        arguments: String,
        function_name: String,
        ?tool: Cadenya::Models::callable_tool
      ) -> void

      def to_hash: -> {
        arguments: String,
        function_name: String,
        tool: Cadenya::Models::callable_tool
      }
    end
  end
end
