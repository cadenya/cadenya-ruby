module Cadenya
  module Models
    type subject_info =
      { objective_count: Integer, tenant: Cadenya::TenantReference }

    class SubjectInfo < Cadenya::Internal::Type::BaseModel
      attr_accessor objective_count: Integer

      attr_accessor tenant: Cadenya::TenantReference

      def initialize: (
        objective_count: Integer,
        tenant: Cadenya::TenantReference
      ) -> void

      def to_hash: -> {
        objective_count: Integer,
        tenant: Cadenya::TenantReference
      }
    end
  end
end
