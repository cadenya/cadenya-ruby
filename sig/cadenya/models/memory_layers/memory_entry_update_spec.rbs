module Cadenya
  module Models
    module MemoryLayers
      type memory_entry_update_spec =
        { content: String, description: String, key: String, upload_id: String }

      class MemoryEntryUpdateSpec < Cadenya::Internal::Type::BaseModel
        attr_reader content: String?

        def content=: (String) -> String

        attr_reader description: String?

        def description=: (String) -> String

        attr_reader key: String?

        def key=: (String) -> String

        attr_reader upload_id: String?

        def upload_id=: (String) -> String

        def initialize: (
          ?content: String,
          ?description: String,
          ?key: String,
          ?upload_id: String
        ) -> void

        def to_hash: -> {
          content: String,
          description: String,
          key: String,
          upload_id: String
        }
      end
    end
  end
end
