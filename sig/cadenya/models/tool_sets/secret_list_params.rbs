module Cadenya
  module Models
    module ToolSets
      type secret_list_params =
        {
          workspace_id: String,
          tool_set_id: String,
          bundle_key: String,
          cursor: String,
          include_info: bool,
          limit: Integer,
          prefix: String,
          query: String,
          sort_order: String
        }
        & Cadenya::Internal::Type::request_parameters

      class SecretListParams < Cadenya::Internal::Type::BaseModel
        extend Cadenya::Internal::Type::RequestParameters::Converter
        include Cadenya::Internal::Type::RequestParameters

        attr_accessor workspace_id: String

        attr_accessor tool_set_id: String

        attr_reader bundle_key: String?

        def bundle_key=: (String) -> String

        attr_reader cursor: String?

        def cursor=: (String) -> String

        attr_reader include_info: bool?

        def include_info=: (bool) -> bool

        attr_reader limit: Integer?

        def limit=: (Integer) -> Integer

        attr_reader prefix: String?

        def prefix=: (String) -> String

        attr_reader query: String?

        def query=: (String) -> String

        attr_reader sort_order: String?

        def sort_order=: (String) -> String

        def initialize: (
          workspace_id: String,
          tool_set_id: String,
          ?bundle_key: String,
          ?cursor: String,
          ?include_info: bool,
          ?limit: Integer,
          ?prefix: String,
          ?query: String,
          ?sort_order: String,
          ?request_options: Cadenya::request_opts
        ) -> void

        def to_hash: -> {
          workspace_id: String,
          tool_set_id: String,
          bundle_key: String,
          cursor: String,
          include_info: bool,
          limit: Integer,
          prefix: String,
          query: String,
          sort_order: String,
          request_options: Cadenya::RequestOptions
        }
      end
    end
  end
end
