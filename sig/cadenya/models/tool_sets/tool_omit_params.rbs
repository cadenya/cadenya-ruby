module Cadenya
  module Models
    module ToolSets
      type tool_omit_params =
        { workspace_id: String, tool_set_id: String, id: String }
        & Cadenya::Internal::Type::request_parameters

      class ToolOmitParams < Cadenya::Internal::Type::BaseModel
        extend Cadenya::Internal::Type::RequestParameters::Converter
        include Cadenya::Internal::Type::RequestParameters

        attr_accessor workspace_id: String

        attr_accessor tool_set_id: String

        attr_accessor id: String

        def initialize: (
          workspace_id: String,
          tool_set_id: String,
          id: String,
          ?request_options: Cadenya::request_opts
        ) -> void

        def to_hash: -> {
          workspace_id: String,
          tool_set_id: String,
          id: String,
          request_options: Cadenya::RequestOptions
        }
      end
    end
  end
end
