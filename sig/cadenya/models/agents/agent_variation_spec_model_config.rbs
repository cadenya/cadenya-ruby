module Cadenya
  module Models
    class AgentVariationSpecModelConfig = Agents::AgentVariationSpecModelConfig

    module Agents
      type agent_variation_spec_model_config =
        { model_id: String, temperature: Float }

      class AgentVariationSpecModelConfig < Cadenya::Internal::Type::BaseModel
        attr_reader model_id: String?

        def model_id=: (String) -> String

        attr_reader temperature: Float?

        def temperature=: (Float) -> Float

        def initialize: (?model_id: String, ?temperature: Float) -> void

        def to_hash: -> { model_id: String, temperature: Float }
      end
    end
  end
end
