module Cadenya
  module Models
    module Agents
      type schedule_resume_params =
        { workspace_id: String, agent_id: String, id: String }
        & Cadenya::Internal::Type::request_parameters

      class ScheduleResumeParams < Cadenya::Internal::Type::BaseModel
        extend Cadenya::Internal::Type::RequestParameters::Converter
        include Cadenya::Internal::Type::RequestParameters

        attr_reader workspace_id: String?

        def workspace_id=: (String) -> String

        attr_accessor agent_id: String

        attr_accessor id: String

        def initialize: (
          agent_id: String,
          id: String,
          ?workspace_id: String,
          ?request_options: Cadenya::request_opts
        ) -> void

        def to_hash: -> {
          workspace_id: String,
          agent_id: String,
          id: String,
          request_options: Cadenya::RequestOptions
        }
      end
    end
  end
end
