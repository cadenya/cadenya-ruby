module Cadenya
  module Models
    type objective_event =
      {
        data: Cadenya::Models::objective_event_data,
        metadata: Cadenya::OperationMetadata,
        context_window_id: String,
        duration: String,
        info: Cadenya::ObjectiveEventInfo,
        started_at: Time
      }

    class ObjectiveEvent < Cadenya::Internal::Type::BaseModel
      attr_accessor data: Cadenya::Models::objective_event_data

      attr_accessor metadata: Cadenya::OperationMetadata

      attr_reader context_window_id: String?

      def context_window_id=: (String) -> String

      attr_reader info: Cadenya::ObjectiveEventInfo?

      def info=: (Cadenya::ObjectiveEventInfo) -> Cadenya::ObjectiveEventInfo

      attr_reader duration: String?

      def duration=: (String) -> String

      attr_reader started_at: Time?

      def started_at=: (Time) -> Time

      def initialize: (
        data: Cadenya::Models::objective_event_data,
        metadata: Cadenya::OperationMetadata,
        ?context_window_id: String,
        ?duration: String,
        ?info: Cadenya::ObjectiveEventInfo,
        ?started_at: Time
      ) -> void

      def to_hash: -> {
        data: Cadenya::Models::objective_event_data,
        metadata: Cadenya::OperationMetadata,
        context_window_id: String,
        duration: String,
        info: Cadenya::ObjectiveEventInfo,
        started_at: Time
      }
    end
  end
end
