module Cadenya
  module Models
    type objective_cancel_params =
      { workspace_id: String, objective_id: String, reason: String }
      & Cadenya::Internal::Type::request_parameters

    class ObjectiveCancelParams < Cadenya::Internal::Type::BaseModel
      extend Cadenya::Internal::Type::RequestParameters::Converter
      include Cadenya::Internal::Type::RequestParameters

      attr_reader workspace_id: String?

      def workspace_id=: (String) -> String

      attr_accessor objective_id: String

      attr_reader reason: String?

      def reason=: (String) -> String

      def initialize: (
        objective_id: String,
        ?workspace_id: String,
        ?reason: String,
        ?request_options: Cadenya::request_opts
      ) -> void

      def to_hash: -> {
        workspace_id: String,
        objective_id: String,
        reason: String,
        request_options: Cadenya::RequestOptions
      }
    end
  end
end
