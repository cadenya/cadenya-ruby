module Cadenya
  module Resources
    class Objectives
      class Tasks
        def retrieve: (
          String objective_id,
          String id,
          ?workspace_id: String,
          ?request_options: Cadenya::request_opts
        ) -> Cadenya::Objectives::ObjectiveTask

        def list: (
          String objective_id,
          ?workspace_id: String,
          ?cursor: String,
          ?limit: Integer,
          ?sort_order: String,
          ?request_options: Cadenya::request_opts
        ) -> Cadenya::Internal::CursorPagination[Cadenya::Objectives::ObjectiveTask]

        def initialize: (client: Cadenya::Client) -> void
      end
    end
  end
end
