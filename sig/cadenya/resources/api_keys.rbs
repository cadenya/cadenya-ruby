module Cadenya
  module Resources
    class APIKeys
      def create: (
        metadata: Cadenya::APIKeyCreateParams::Metadata,
        spec: Cadenya::APIKeySpec,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::APIKey

      def retrieve: (
        String id,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::APIKey

      def update: (
        String id,
        ?workspace_id: String,
        ?metadata: Cadenya::APIKeyUpdateParams::Metadata,
        ?spec: Cadenya::APIKeySpec,
        ?update_mask: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::APIKey

      def list: (
        ?workspace_id: String,
        ?cursor: String,
        ?include_info: bool,
        ?labels: String,
        ?limit: Integer,
        ?prefix: String,
        ?query: String,
        ?sort_order: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::Internal::CursorPagination[Cadenya::APIKey]

      def delete: (
        String id,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> nil

      def disable: (
        String id,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::APIKey

      def enable: (
        String id,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::APIKey

      def rotate: (
        String id,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::APIKey

      def initialize: (client: Cadenya::Client) -> void
    end
  end
end
