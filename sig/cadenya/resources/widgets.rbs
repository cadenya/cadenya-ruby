module Cadenya
  module Resources
    class Widgets
      def create: (
        metadata: Cadenya::CreateResourceMetadata,
        spec: Cadenya::WidgetSpec,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::Widget

      def retrieve: (
        String id,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::Widget

      def update: (
        String id,
        ?workspace_id: String,
        ?metadata: Cadenya::UpdateResourceMetadata,
        ?spec: Cadenya::WidgetSpec,
        ?update_mask: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::Widget

      def list: (
        ?workspace_id: String,
        ?agent_id: String,
        ?cursor: String,
        ?include_info: bool,
        ?labels: String,
        ?limit: Integer,
        ?sort_order: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::Internal::CursorPagination[Cadenya::Widget]

      def delete: (
        String id,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> nil

      def archive: (
        String id,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::Widget

      def unarchive: (
        String id,
        ?workspace_id: String,
        ?request_options: Cadenya::request_opts
      ) -> Cadenya::Widget

      def initialize: (client: Cadenya::Client) -> void
    end
  end
end
