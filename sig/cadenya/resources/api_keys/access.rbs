module Cadenya
  module Resources
    class APIKeys
      class Access
        def list: (
          String id,
          ?cursor: String,
          ?limit: Integer,
          ?request_options: Cadenya::request_opts
        ) -> Cadenya::Internal::CursorPagination[Cadenya::Workspace]

        def add: (
          String id,
          ?workspace_id: String,
          ?request_options: Cadenya::request_opts
        ) -> Cadenya::APIKey

        def remove: (
          String workspace_id,
          id: String,
          ?request_options: Cadenya::request_opts
        ) -> nil

        def initialize: (client: Cadenya::Client) -> void
      end
    end
  end
end
